{
    "name": "octobot",
    "version": "2.0.0",
    "main": "src/index.ts",
    "engines": {
        "node": ">=22.13.1",
        "bun": ">=1.2.0"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build ./src/index.ts --outdir ./dist --target node",
        "start": "bun run src/index.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "cors": "^2.8.6",
        "discord.js": "^14.27.0",
        "dotenv": "^16.6.1",
        "express": "^4.22.2",
        "mongoose": "^8.24.3",
        "octokit": "^4.1.4",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "bun-types": "^1.3.14",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    }
}
