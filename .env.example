# ==============================================================================
# OctoBot V1 - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Discord Gateway Configuration (Required)
# ------------------------------------------------------------------------------
# Bot token generated in the Discord Developer Portal (Bot tab -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_secret

# Application Client ID (General Information -> Application ID)
DISCORD_CLIENT_ID=your_discord_application_client_id

# Target Discord Server Guild ID where slash commands will be registered
DISCORD_GUILD_ID=your_discord_guild_id

# Optional fallback channel ID (subscriptions are configured per channel via /github repo watch)
# DISCORD_CHANNEL_ID=your_optional_default_channel_id

# ------------------------------------------------------------------------------
# 3. MongoDB Persistence Configuration (Required)
# ------------------------------------------------------------------------------
# Connection string with credentials for MongoDB (operational subscriptions, idempotency, CI state)
MONGODB_URI=mongodb://user:password@localhost:27017/octobot?authSource=admin
# MONGODB_DB_NAME=octobot

# ------------------------------------------------------------------------------
# 4. GitHub Integration Configuration (Required)
# ------------------------------------------------------------------------------
# Fine-grained or Classic Personal Access Token with repo/admin:repo_hook permissions
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Default GitHub organization or user account owning the repositories
GITHUB_OWNER=your_github_org_or_username

# Shared secret configured in GitHub Webhooks for HMAC SHA-256 validation (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_shared_secret

# Publicly reachable base URL of the OctoBot ingress service (used to register GitHub Webhooks)
# Must use HTTPS in production (e.g. https://octobot.yourdomain.com)
API_URL=https://octobot.yourdomain.com