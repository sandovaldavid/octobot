# ==============================================================================
# OctoBot - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Discord Gateway Configuration (Required)
# ------------------------------------------------------------------------------
# Bot token generated in Discord Developer Portal (Bot tab -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_secret

# Application Client ID (General Information -> Application ID)
DISCORD_CLIENT_ID=your_discord_application_client_id

# Publicly reachable base URL of OctoBot (used for GitHub App OAuth and Webhooks)
# Must use HTTPS in production (e.g. https://octobot.yourdomain.com)
API_URL=https://octobot.yourdomain.com

# ------------------------------------------------------------------------------
# 3. MongoDB Persistence Configuration (Required)
# ------------------------------------------------------------------------------
# Connection string with credentials for MongoDB
MONGODB_URI=mongodb://user:password@localhost:27017/octobot?authSource=admin

# ------------------------------------------------------------------------------
# 4. GitHub App Configuration (Canonical Multi-Tenant Mode - Recommended)
# ------------------------------------------------------------------------------
# GitHub App ID (General settings -> App ID)
GITHUB_APP_ID=123456

# GitHub App RSA Private Key (PEM string formatted with newlines or single-line \n)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Shared secret configured in GitHub App settings for webhook HMAC SHA-256 validation
GITHUB_WEBHOOK_SECRET=your_github_webhook_shared_secret

# GitHub App Client ID (for OAuth handshake / proof-of-association)
GITHUB_CLIENT_ID=your_github_oauth_client_id

# GitHub App Client Secret (for OAuth handshake token exchange)
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Optional GitHub App public slug (defaults to octobot-app)
GITHUB_APP_SLUG=octobot-app

# ------------------------------------------------------------------------------
# 5. Legacy Single-Tenant PAT Mode (Deprecated Fallback)
# ------------------------------------------------------------------------------
# NOTE: Only provide these if running in legacy PAT mode without GitHub App credentials.
# Legacy PAT mode will be removed in a future major release.

# DISCORD_GUILD_ID=your_discord_guild_id
# GITHUB_TOKEN=ghp_your_github_personal_access_token
# GITHUB_OWNER=your_github_org_or_username